  "narrative": {
    "dos": [
      "Do preserve the serif task heading and sans-serif controls.",
      "Do retain visible focus outlines and written status labels.",
      "Do stack task, scope, and results in their existing reading order on mobile.",
      "Do keep fixture notices and score qualification close to the relevant action or result."
    ],
    "overview": "The implemented direction is a functional light workspace with a green primary action, a serif task heading, and readable system sans text. The form carries the action; quieter supporting content explains its scope and the results carry the evidence. This name describes the established direction rather than claiming a separate brand workshop.\n\nThe system uses compact controls inside a generous page rhythm. Notices and textual status labels keep prototype and fixture limitations visible. No external fonts or brand imagery are required.",
    "northStar": "The Calm Scanner Workspace",
    "keyCharacteristics": [
      "Calm light surfaces and dark green action emphasis.",
      "Serif task heading paired with system sans interface text.",
      "Bordered, flat containers and visible keyboard focus.",
      "Explicit result labels and a mobile reading order that follows the task."
    ],
    "rules": [
      {
        "section": "colors",
        "name": "The Labeled State Rule",
        "body": "Color accompanies a written state or risk label; it never carries the meaning alone."
      },
      {
        "section": "typography",
        "name": "The Task Heading Rule",
        "body": "Reserve the serif display treatment for the primary task heading; use sans-serif for controls and evidence headings."
      },
      {
        "section": "elevation",
        "name": "The Flat Surface Rule",
        "body": "Preserve tonal separation and borders as the depth vocabulary."
      }
    ],
    "donts": [
      "Don't use color as the only signal for risk, error, or readiness.",
      "Don't add shadow-driven card depth to this flat workspace without revisiting the visual direction.",
      "Don't style fixture scores as verified predictions."
    ]
  }
}
